"""
.env.example — copy this to .env and fill in your values.
Never commit the real .env to git.
"""

# Required: your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: model override (default: claude-sonnet-4-5)
# VERA_MODEL=claude-opus-4-5

# Optional: team metadata (shown in /v1/metadata)
TEAM_NAME=Your Name
TEAM_MEMBERS=Your Name
CONTACT_EMAIL=you@example.com
SUBMITTED_AT=2026-08-26T10:00:00Z
